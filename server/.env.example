# Backend Port
PORT=3001
# cPanel must override this with NODE_ENV=production.
NODE_ENV=development

# Database Connection (PostgreSQL)
# Update these with your specific cPanel credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_username_servicios_db
DB_USER=your_username_servicios_user
DB_PASSWORD=your_strong_password

# Use https://serviciosatuhogar.cl in production. Multiple origins are comma-separated.
CORS_ORIGIN=http://localhost:3000

# Session security
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=2h

# Payku Payment Gateway
# Sandbox: https://des.payku.cl/api | Production: https://app.payku.cl/api
PAYKU_MODE=sandbox
PAYKU_API_URL=https://des.payku.cl/api
PAYKU_PUBLIC_TOKEN=your_public_token_here
PAYKU_PRIVATE_TOKEN=your_private_token_here

# Application URLs (for payment callbacks)
APP_URL=https://serviciosatuhogar.cl
FRONTEND_URL=https://serviciosatuhogar.cl
API_URL=https://serviciosatuhogar.cl/api

# Stage 2 booking integrity
# Generate at least 32 random characters. Keep previous values, comma-separated,
# in BOOKING_CAPABILITY_SECRETS during key rotation.
BOOKING_CAPABILITY_SECRET=
BOOKING_CAPABILITY_SECRETS=
BOOKING_HOLD_MINUTES=30

# Stage 7B observability
# JSON logs rotate locally; keep this directory outside public web roots.
LOG_FILE_ENABLED=true
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_SIZE_BYTES=5242880
LOG_MAX_FILES=5
OBSERVABILITY_MONITOR_ENABLED=true
OBSERVABILITY_INTERVAL_MS=60000
OBS_DB_WAITING_THRESHOLD=5
OBS_DISK_FREE_PERCENT_THRESHOLD=10
OBS_OUTBOX_LAG_SECONDS_THRESHOLD=300
ALERT_DEDUP_WINDOW_MS=300000
# Optional external channels. Leave blank until the owner provides them.
DISCORD_WEBHOOK_URL=
ADMIN_EMAIL=
